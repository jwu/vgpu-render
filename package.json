{
  "name": "vgpu-render",
  "version": "0.4.2",
  "description": "WebGPU debug-draw, gizmo, infinite grid and text layer built on vgpu",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "webgpu",
    "wgsl",
    "vgpu",
    "debug-draw",
    "gizmo",
    "gizmos",
    "infinite-grid",
    "text-rendering",
    "msdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwu/vgpu-render.git"
  },
  "homepage": "https://jwu.github.io/vgpu-render/",
  "bugs": {
    "url": "https://github.com/jwu/vgpu-render/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/strip-brand-from-dist.ts",
    "prepublishOnly": "bun run typecheck && bun run build:lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vgpu": "^0.6.0"
  },
  "dependencies": {
    "@vgpu/wgsl": "^0.6.0",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vgpu/wgsl": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vgpu": "^0.6.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
