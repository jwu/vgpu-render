node_modules/
dist/
coverage/
# The bevy reference harness builds into bevy's own target directory (see
# docs/text-reference.md), but a plain `cargo build` in it would drop a target/ of its own.
tools/bevy-text-reference/target/
*.log
.env
.env.*
!.env.example
.DS_Store

# Visual parity baselines are local diagnostic artifacts, not sources: recapture them with
# `bun scripts/capture-vgpu.ts` plus the Godot copies described in docs/visual-comparison.md.
# Only the comparison page stays tracked; the PNGs are regenerated on demand.
artifacts/visual-baseline/*
!artifacts/visual-baseline/index.html
